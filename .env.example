PORT=3000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (exact match, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Session lifetimes (seconds). Keep the access token short to practice expiry handling.
ACCESS_TOKEN_TTL_SECONDS=120
REFRESH_TOKEN_TTL_SECONDS=604800

# Cookie settings. For a frontend on a different site in production use SameSite=none (requires HTTPS).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Artificial latency for every request (ms)
LATENCY_MS=0

# Enables /debug/* routes plus ?_delay=ms and ?_fail=status query params (never enable in production)
ENABLE_DEBUG_ROUTES=true
